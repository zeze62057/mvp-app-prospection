{
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Bash(git push *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
