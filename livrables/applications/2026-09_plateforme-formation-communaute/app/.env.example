# Copier ce fichier en .env.local (jamais commite) et renseigner les vraies valeurs.
# Trouvables dans Supabase : Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle secrete, jamais exposee au navigateur, utilisee uniquement cote serveur
# (routes API, webhooks). Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Paiement (Chariow orchestre par n8n, voir CADRAGE.md section 6) :
# URL du workflow n8n qui cree une session de paiement Chariow et renvoie
# { checkout_url }. Vide tant que ce workflow n'existe pas.
N8N_WEBHOOK_CREER_PAIEMENT_URL=

# Secret partage avec n8n pour verifier les appels entrants sur
# /api/webhooks/paiement (header x-webhook-secret). A generer et a mettre
# aussi cote n8n.
WEBHOOK_PAIEMENT_SECRET=
