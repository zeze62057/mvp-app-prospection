# ============================================================
#  .env.example  -  Template public des variables d'environnement
# ============================================================
#
#  Ce fichier liste les variables attendues par le workspace,
#  SANS aucune valeur secrete. Il peut etre partage et versionne.
#
#  Utilisation :
#  1. Copie ce fichier en .env       (cp .env.example .env)
#  2. Renseigne tes vraies cles dans .env
#  3. Ne commite jamais .env (il est exclu par .gitignore)
# ============================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=

# --- Google (Cloud / Workspace APIs) ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube Data API ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
